# ---- Local development ----
# Copy this file to .env. Vercel reads the same names from its dashboard
# (Project → Settings → Environment Variables), not from this file.

# Local:  mongodb://127.0.0.1:27017/jack-portfolio
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/jack-portfolio
MONGODB_URI=mongodb://127.0.0.1:27017/jack-portfolio

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Used once by `npm run seed` to create the admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ---- Local only, leave unset on Vercel ----
PORT=4000
PUBLIC_URL=http://localhost:4000

# ---- Vercel only ----
# Added automatically when you create a Blob store in the Vercel dashboard.
# When present, uploads go to Blob instead of the local disk.
# BLOB_READ_WRITE_TOKEN=

# Only needed if the front end is on a different domain than the API.
# CLIENT_ORIGIN=
